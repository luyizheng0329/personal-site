---
// src/components/layout/BaseLayout.astro
// 全局基础布局 —— SEO 优化 + 字体 + 响应式
import '../../styles/global.css';
import Nav from './Nav.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
}
const { title, description, image } = Astro.props;
const fullTitle = `${title} | Luyiz`;
const defaultDesc = '个人记忆中枢——用电流连接每一个瞬间';
const siteUrl = 'https://luyiz.github.io/personal-site';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>

  <!-- SEO -->
  <meta name="description" content={description || defaultDesc} />
  <link rel="canonical" href={siteUrl} />
  <link rel="alternate" type="application/rss+xml" title="Luyiz RSS" href={`${siteUrl}/rss.xml`} />
  <link rel="sitemap" href={`${siteUrl}/sitemap-index.xml`} />

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description || defaultDesc} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={siteUrl} />
  {image && <meta property="og:image" content={image} />}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/personal-site/favicon.svg" />

  <!-- 字体 -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0/style.css" />
</head>

<body class="min-h-screen">
  <Nav />
  <main class="min-h-screen">
    <slot />
  </main>
</body>
</html>
