---
// [预留] 恋爱日记模块
// 启用后请取消内容 schema 注释并创建 src/content/love/ 下的第一篇内容
import BaseLayout from '../../components/layout/BaseLayout.astro';
---

<BaseLayout title="恋爱日记" description="粉色的心动瞬间">
  <div class="max-w-6xl mx-auto px-6 py-20 text-center">
    <h1 class="text-4xl font-display tracking-widest mb-4" style="color: var(--color-love); text-shadow: 0 0 20px var(--color-love);">
      恋爱日记
    </h1>
    <p class="text-lg" style="color: var(--color-text-secondary);">
      浪漫粉 · 心动瞬间
    </p>
    <p class="mt-12 text-sm" style="color: var(--color-text-muted);">
      🌸 此模块已预留，等待未来的某一天启用。
    </p>
  </div>
</BaseLayout>
